# ==========================
# VS Code
# ==========================
# .vscode/* not .vscode/ -- git does not descend into an ignored DIRECTORY,
# so the negations below had no effect and settings.json could never be
# committed no matter what they said.
.vscode/*
!.vscode/extensions.json
# settings.json is NOT negated: ours pins an absolute interpreter path on
# one machine, which is wrong for everybody else who clones this.

