# The intelligence CLIs read backend/.env (see graph/env.py), not a file
# here. Use backend/.env.example for the full list of keys. The ones the
# CLIs themselves need:
NEO4J_URI=...
NEO4J_USERNAME=...
NEO4J_PASSWORD=...
# --owner is resolved against the accounts table in Postgres.
SUPABASE_URL=...
SUPABASE_SECRET_KEY=...
GEMINI_API_KEY=...
# Headless scans only (the web app uses each user's own connection).
GITHUB_TOKEN=...
SCAN_MAX_CANDIDATES=400
