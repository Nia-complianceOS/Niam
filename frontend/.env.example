# API URL for the backend
VITE_API_BASE_URL=...

# No Supabase keys here on purpose. The browser never talks to Postgres
# directly -- it talks to this project's own API, which holds the
# service-role key server-side. A VITE_* variable is baked into the
# bundle and readable by anyone who opens the page, so an anon key here
# would be a standing invitation to query the users table the moment a
# permissive row-level-security policy appeared.
