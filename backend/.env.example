# Copy to backend/.env and fill in. Every key backend/app/core/config.py
# reads is listed here. The intelligence CLIs read this same file.

APP_NAME=Niam Backend
# development | production. Outside development: unsigned webhooks are
# refused, a missing TOKEN_ENCRYPTION_KEY blocks storing GitHub tokens,
# and a weak JWT_SECRET stops the API from starting.
APP_ENV=development
DEBUG=false

# Long random string (32+ characters).
JWT_SECRET=...
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=...

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Compliance graph
NEO4J_URI=...
NEO4J_USERNAME=...
NEO4J_PASSWORD=...

# Accounts, workspaces, reviews, scans, audit log. Use the SERVICE ROLE
# (secret) key, not the anon key. Run backend/migrations/001..006 first.
SUPABASE_URL=...
SUPABASE_SECRET_KEY=...

# GitHub OAuth App: connect GitHub and "Continue with GitHub" sign-in.
GITHUB_CLIENT_ID=...
GITHUB_CLIENT_SECRET=...
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/github/oauth/callback
GITHUB_WEBHOOK_SECRET=...
# Headless CLI runs only. The API never uses it.
GITHUB_TOKEN=...

# Pull requests stay off until you opt in, per repository.
GITHUB_DRY_RUN=true
PR_ALLOWED_REPOS=

SCAN_RATE_LIMIT_PER_HOUR=10
SCAN_MAX_CONCURRENT=2
# Candidate lines classified per scan (intelligence scanner).
SCAN_MAX_CANDIDATES=400

GEMINI_API_KEY=...

# Optional vendor ingestion (CLI)
MIXPANEL_TOKEN=...
MIXPANEL_SERVICE_ACCOUNT_USERNAME=...
MIXPANEL_SERVICE_ACCOUNT_SECRET=...
MIXPANEL_PROJECT_ID=...
FIREBASE_SERVICE_ACCOUNT_PATH=...
